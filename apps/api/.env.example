# SchoolView API
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Supabase project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SERVER-ONLY secret. Never put this in the mobile or web apps.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# MediaMTX local Control API
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_USERNAME=
MEDIAMTX_API_PASSWORD=

# Random private secret for internal streaming operations.
# Generate a long random value before using it.
STREAMING_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Local development origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

STREAM_PUBLISH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
